<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <!-- 高分辨率适配：PerMonitorV2 逐显示器 DPI 感知，配合 app.manifest 的 dpiAwareness 声明。
         各窗体 AutoScaleMode.Dpi 按实际 DPI 缩放，高分屏不再被 DWM 位图拉伸模糊。 -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>HFNUautologin</AssemblyName>
    <RootNamespace>CampusAutoLogin</RootNamespace>
    <Version>2.0.7</Version>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- v2.0.4：以管理员身份运行的清单直接编译进 exe（替代绑定路径的注册表 RUNASADMIN） -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>校园网自动登录</Product>
    <AssemblyTitle>校园网自动登录</AssemblyTitle>
    <Description>华为 ePortal (ACSetting) 校园网自动登录工具</Description>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- DPAPI 凭据加密 -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <!-- PowerModeChanged 休眠唤醒事件 -->
    <PackageReference Include="Microsoft.Win32.SystemEvents" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- 校徽图标：同时作为 exe 图标与托盘底图（按需取指定尺寸帧） -->
    <EmbeddedResource Include="app.ico" LogicalName="CampusAutoLogin.app.ico" />
  </ItemGroup>

</Project>
